upstream bookboll_api {
    zone bookboll_api 64k;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    server ${BACKEND_HOST}:8080 resolve;
    keepalive 16;
}
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 30m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    gzip on;
    gzip_types application/json application/javascript text/css image/svg+xml;
    gzip_min_length 1000;
    location = /health { access_log off; return 200 "ok"; }
    location ~ /\. { deny all; }
    location /api/ {
        proxy_pass http://bookboll_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
    location /storage/ { proxy_pass http://bookboll_api; }
    location /assets/ { try_files $uri =404; expires 1y; add_header Cache-Control "public, immutable"; }
    location / { try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; }
}
